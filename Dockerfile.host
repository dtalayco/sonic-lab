FROM debian:bookworm-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        iproute2 \
        tcpdump \
        bridge-utils \
        ifenslave \
        ethtool \
        iputils-ping \
        net-tools \
        curl && \
    rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]