# Host for the Homa lab. Ubuntu 24.04 to match the VM, so the cp_node built
# there runs as is. The Homa stack itself is the module in the VM's kernel.
FROM ubuntu:24.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        iproute2 \
        iputils-ping \
        ethtool \
        tcpdump \
        python3 \
        libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
