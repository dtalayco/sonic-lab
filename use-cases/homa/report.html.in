<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{TITLE}}</title>
<style>
:root {
  color-scheme: light;
  --surface-0: #f4f4f2; --surface-1: #fcfcfb; --border: #dcdbd6;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77766f;
  --grid: #e6e5e0; --band: rgba(11, 11, 11, 0.045);
  --series-1: #2a78d6; --series-2: #eb6834;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --surface-0: #111110; --surface-1: #1a1a19; --border: #33332f;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #96958c;
    --grid: #2a2a27; --band: rgba(240, 239, 236, 0.05);
    --series-1: #3987e5; --series-2: #d95926;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #111110; --surface-1: #1a1a19; --border: #33332f;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #96958c;
  --grid: #2a2a27; --band: rgba(240, 239, 236, 0.05);
  --series-1: #3987e5; --series-2: #d95926;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface-0); color: var(--text-primary);
       font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
main { max-width: 1120px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 1.35rem; margin: 0 0 4px; }
h2 { font-size: 1rem; margin: 28px 0 10px; }
.meta { color: var(--text-secondary); margin: 0 0 16px; font-size: 0.85rem; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
.chart-title { font-weight: 600; font-size: 0.85rem; overflow-wrap: anywhere; }
.legend { color: var(--text-secondary); font-size: 0.75rem; margin-top: 2px; }
.legend span { display: inline-flex; align-items: center; margin-right: 12px; }
.swatch { width: 12px; height: 3px; border-radius: 2px; margin-right: 6px; display: inline-block; }
svg { display: block; width: 100%; height: auto; overflow: visible; }
svg text { fill: var(--text-muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; font-size: 0.85rem; }
th, td { padding: 6px 10px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
th:first-child, td:first-child, th:nth-child(2), td:nth-child(2) { text-align: left; }
th { color: var(--text-secondary); font-weight: 600; font-size: 0.75rem; }
.empty { color: var(--text-muted); }
#tip { position: fixed; pointer-events: none; display: none; z-index: 10; background: var(--surface-1);
       border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; font-size: 0.75rem;
       box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15); font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<main>
<h1>{{TITLE}}</h1>
<p class="meta" id="meta"></p>

<h2>Phases</h2>
<div class="card table-wrap" id="phases"></div>

<h2>Throughput</h2>
<p class="meta">Sum over every link and direction, so a packet that crosses the switch is counted on both of its links.</p>
<div class="card" id="total"></div>

<h2>Per link</h2>
<div class="grid" id="links"></div>

<section id="queues-section" hidden>
<h2>Queues</h2>
<div class="grid" id="queues"></div>
</section>

<section id="homa-section" hidden>
<h2>Homa</h2>
<div class="grid" id="homa"></div>
</section>
</main>
<div id="tip"></div>

<script>
const DATA = {{DATA}};
const COLORS = ['var(--series-1)', 'var(--series-2)'];

function fmt(v, unit) {
  if (unit === 'bps') {
    if (v >= 1e9) return (v / 1e9).toFixed(2) + ' Gb/s';
    if (v >= 1e6) return (v / 1e6).toFixed(1) + ' Mb/s';
    if (v >= 1e3) return (v / 1e3).toFixed(0) + ' kb/s';
    return v.toFixed(0) + ' b/s';
  }
  if (unit === 'bytes') {
    if (v >= 1e6) return (v / 1e6).toFixed(1) + ' MB';
    if (v >= 1e3) return (v / 1e3).toFixed(0) + ' KB';
    return v.toFixed(0) + ' B';
  }
  return (v >= 100 ? v.toFixed(0) : v.toFixed(1)) + '/s';
}
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'})[c]); }
function seriesMax(spec) {
  return Math.max(1e-9, ...spec.series.flatMap(s => s.points.map(p => p[1])));
}
// Round up to 1, 2 or 5 times a power of ten, so axis labels read cleanly
function niceMax(v) {
  const p = Math.pow(10, Math.floor(Math.log10(v)));
  return [1, 2, 5, 10].map(m => m * p).find(m => m >= v);
}
function phaseName(p) { return p.label + ' · ' + p.proto; }

// One line chart on a shared time axis, with phase bands behind it.
function chart(el, spec, opts) {
  const W = opts.width || 720, H = opts.height || 160, L = 70, R = 8, T = opts.bandLabels ? 18 : 6, B = 22;
  const span = Math.max(DATA.span, 1);
  const max = opts.max || niceMax(seriesMax(spec));
  const x = t => L + t / span * (W - L - R);
  const y = v => T + (1 - v / max) * (H - T - B);

  let svg = '';
  DATA.phases.forEach((p, i) => {
    svg += '<rect x="' + x(p.start) + '" y="' + T + '" width="' + Math.max(1, x(p.end) - x(p.start)) +
           '" height="' + (H - T - B) + '" fill="var(--band)"/>';
    if (opts.bandLabels && x(p.end) - x(p.start) > 36)
      svg += '<text x="' + (x(p.start) + 3) + '" y="12">' + esc(i + 1) + '</text>';
  });
  [0, 0.5, 1].forEach(f => {
    const yy = y(max * f);
    svg += '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + yy + '" y2="' + yy + '" stroke="var(--grid)"/>' +
           '<text x="' + (L - 6) + '" y="' + (yy + 4) + '" text-anchor="end">' + esc(fmt(max * f, spec.unit)) + '</text>';
  });
  const step = span > 240 ? 60 : span > 60 ? 30 : 10;
  for (let t = 0; t <= span; t += step)
    svg += '<text x="' + x(t) + '" y="' + (H - 6) + '" text-anchor="middle">' + t + 's</text>';
  spec.series.forEach((s, k) => {
    if (s.points.length < 2) return;
    svg += '<polyline fill="none" stroke="' + COLORS[k] + '" stroke-width="2" stroke-linejoin="round"' +
           ' stroke-linecap="round" points="' + s.points.map(p => x(p[0]).toFixed(1) + ',' + y(p[1]).toFixed(1)).join(' ') + '"/>';
  });
  svg += '<line class="cross" y1="' + T + '" y2="' + (H - B) + '" stroke="var(--text-muted)" visibility="hidden"/>' +
         '<rect class="hit" x="' + L + '" y="0" width="' + (W - L - R) + '" height="' + H + '" fill="transparent"/>';

  let legend = '';
  if (spec.series.length > 1)
    legend = '<div class="legend">' + spec.series.map((s, k) =>
      '<span><i class="swatch" style="background:' + COLORS[k] + '"></i>' + esc(s.name) + '</span>').join('') + '</div>';
  el.innerHTML = (opts.title === false ? '' : '<div class="chart-title">' + esc(spec.title) + '</div>') + legend +
    '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + esc(spec.title) + '">' + svg + '</svg>';

  const node = el.querySelector('svg'), cross = node.querySelector('.cross'), tip = document.getElementById('tip');
  node.querySelector('.hit').addEventListener('mousemove', e => {
    const r = node.getBoundingClientRect();
    const t = ((e.clientX - r.left) / r.width * W - L) / (W - L - R) * span;
    let rows = '', tx = null;
    spec.series.forEach((s, k) => {
      let best = null;
      s.points.forEach(p => { if (!best || Math.abs(p[0] - t) < Math.abs(best[0] - t)) best = p; });
      if (!best) return;
      tx = best[0];
      rows += '<div><i class="swatch" style="background:' + COLORS[k] + '"></i>' +
              (spec.series.length > 1 ? esc(s.name) + ': ' : '') + esc(fmt(best[1], spec.unit)) + '</div>';
    });
    if (tx === null) return;
    const ph = DATA.phases.find(p => tx >= p.start && tx <= p.end);
    cross.setAttribute('x1', x(tx)); cross.setAttribute('x2', x(tx)); cross.setAttribute('visibility', 'visible');
    tip.innerHTML = '<div>' + tx.toFixed(0) + 's' + (ph ? ' · ' + esc(phaseName(ph)) : '') + '</div>' + rows;
    tip.style.display = 'block';
    tip.style.left = Math.min(e.clientX + 12, innerWidth - tip.offsetWidth - 8) + 'px';
    tip.style.top = (e.clientY + 12) + 'px';
  });
  node.querySelector('.hit').addEventListener('mouseleave', () => {
    tip.style.display = 'none'; cross.setAttribute('visibility', 'hidden');
  });
}

function phaseTable() {
  const el = document.getElementById('phases');
  if (!DATA.phases.length) { el.innerHTML = '<p class="empty">No phases recorded (run without EVENTS set).</p>'; return; }
  const buckets = ['<=1KB', '1-100KB', '>100KB'];
  const us = v => v === undefined ? '–' : v >= 10000 ? (v / 1000).toFixed(0) + ' ms' : v.toFixed(0) + ' µs';
  let h = '<table><thead><tr><th>#</th><th>Phase</th><th>Time</th><th>Gb/s</th>' +
          buckets.map(b => '<th>' + esc(b) + ' p50</th><th>' + esc(b) + ' p99</th>').join('') + '</tr></thead><tbody>';
  DATA.phases.forEach((p, i) => {
    h += '<tr><td>' + (i + 1) + '</td><td>' + esc(phaseName(p)) + '</td><td>' + p.start.toFixed(0) + '–' +
         p.end.toFixed(0) + 's</td><td>' + (p.gbps == null ? '–' : p.gbps.toFixed(2)) + '</td>' +
         buckets.map(b => { const r = p.rtt[b] || {}; return '<td>' + us(r.p50_us) + '</td><td>' + us(r.p99_us) + '</td>'; }).join('') +
         '</tr>';
  });
  el.innerHTML = h + '</tbody></table>';
}

function grid(id, specs, sectionId) {
  const el = document.getElementById(id);
  if (sectionId) document.getElementById(sectionId).hidden = !specs.length;
  // Small multiples share a y scale per unit, so they compare by eye
  const maxes = {};
  specs.forEach(spec => { maxes[spec.unit] = Math.max(maxes[spec.unit] || 0, seriesMax(spec)); });
  specs.forEach(spec => {
    const card = document.createElement('div');
    card.className = 'card';
    el.appendChild(card);
    chart(card, spec, { width: 360, height: 170, max: niceMax(maxes[spec.unit]) });
  });
}

const run = DATA.run, keys = Object.keys(run);
document.getElementById('meta').textContent =
  (keys.length ? keys.map(k => k + '=' + run[k]).join(' · ') + ' · ' : '') + DATA.span.toFixed(0) + 's recorded';
phaseTable();
chart(document.getElementById('total'), DATA.charts.total, { height: 200, bandLabels: true, title: false });
grid('links', DATA.charts.links);
grid('queues', DATA.charts.queues, 'queues-section');
grid('homa', DATA.charts.homa, 'homa-section');
</script>
</body>
</html>
