@@ -63,8 +63,15 @@ extern double  to_seconds(uint64_t cycles);
 inline static uint64_t rdtsc(void)
 {
+#ifdef __aarch64__
+	uint64_t v;
+
+	__asm__ __volatile__("mrs %0, cntvct_el0" : "=r" (v));
